#*************************************************************************
#
# Tests for ALTER TABLE <table> ADD CONSTRAINT <name> ...
#
#   ADD CONSTRAINT n UNIQUE(...)
#   ADD CONSTRAINT n PRIMARY KEY(...)
#   ADD CONSTRAINT n FOREIGN KEY(...) REFERENCES ...
#   COLUMN <column> ADD DEFAULT <value>
#
# The name is required in the ADD CONSTRAINT forms, which all become
# table-constraints.  A DEFAULT belongs to one column rather than to the
# table, so it names the column instead and carries no name of its own.
#
# What is stored is the text as written, spliced in at a position the
# parser recorded rather than one found by scanning.  UNIQUE and PRIMARY
# KEY also bring an automatic index with them, so most of what is checked
# here is that the result is indistinguishable from a table created with
# the constraint in the first place.
#

set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix altercons5

# If SQLITE_OMIT_ALTERTABLE is defined, omit this file.
ifcapable !altertable {
  finish_test
  return
}

#-------------------------------------------------------------------------
# UNIQUE.
#
reset_db
do_execsql_test 1.0 {
  CREATE TABLE t1(a INT, b TEXT);
  INSERT INTO t1 VALUES(1,'x'),(2,'y');
  ALTER TABLE t1 ADD CONSTRAINT u1 UNIQUE(a);
  SELECT type, name, coalesce(sql,'-') FROM sqlite_schema ORDER BY name;
} {index sqlite_autoindex_t1_1 - table t1 {CREATE TABLE t1(a INT, b TEXT, CONSTRAINT u1 UNIQUE(a))}}
do_execsql_test 1.1 {
  SELECT name, "unique", origin FROM pragma_index_list('t1');
} {sqlite_autoindex_t1_1 1 u}
do_execsql_test 1.2 { PRAGMA integrity_check } {ok}
do_execsql_test 1.3 { SELECT a, b FROM t1 ORDER BY a } {1 x 2 y}

# The constraint is live afterwards.
do_catchsql_test 1.4 {
  INSERT INTO t1 VALUES(1,'z');
} {1 {UNIQUE constraint failed: t1.a}}

# Several columns, a collation and a sort order all survive as written.
reset_db
do_execsql_test 1.5 {
  CREATE TABLE t1(a,b,c);
  ALTER TABLE t1 ADD CONSTRAINT u1 UNIQUE(a, b COLLATE nocase DESC);
  SELECT sql FROM sqlite_schema WHERE type='table';
} {{CREATE TABLE t1(a,b,c, CONSTRAINT u1 UNIQUE(a, b COLLATE nocase DESC))}}
do_execsql_test 1.6 {
  SELECT il.name, ii.seqno, ii.name
    FROM pragma_index_list('t1') il, pragma_index_info(il.name) ii;
} {sqlite_autoindex_t1_1 0 a sqlite_autoindex_t1_1 1 b}

# Automatic indexes are numbered from the constraints the table already
# has.  An index made by CREATE INDEX does not take a number.
reset_db
do_execsql_test 1.7 {
  CREATE TABLE t1(a TEXT UNIQUE, b INT, c);
  CREATE INDEX ix ON t1(c);
  ALTER TABLE t1 ADD CONSTRAINT u2 UNIQUE(b);
  SELECT type, name FROM sqlite_schema ORDER BY name;
} {index ix index sqlite_autoindex_t1_1 index sqlite_autoindex_t1_2 table t1}
do_execsql_test 1.8 { PRAGMA integrity_check } {ok}

#-------------------------------------------------------------------------
# PRIMARY KEY.
#
reset_db
do_execsql_test 2.0 {
  CREATE TABLE t1(a TEXT, b INT);
  INSERT INTO t1 VALUES('k',1);
  ALTER TABLE t1 ADD CONSTRAINT p1 PRIMARY KEY(a);
  SELECT type, name, coalesce(sql,'-') FROM sqlite_schema ORDER BY name;
} {index sqlite_autoindex_t1_1 - table t1 {CREATE TABLE t1(a TEXT, b INT, CONSTRAINT p1 PRIMARY KEY(a))}}
do_execsql_test 2.1 {
  SELECT name, pk FROM pragma_table_info('t1');
} {a 1 b 0}
do_execsql_test 2.2 {
  SELECT name, origin FROM pragma_index_list('t1');
} {sqlite_autoindex_t1_1 pk}
do_execsql_test 2.3 { PRAGMA integrity_check } {ok}
do_catchsql_test 2.4 {
  INSERT INTO t1 VALUES('k',2);
} {1 {UNIQUE constraint failed: t1.a}}

# On a WITHOUT ROWID table the PRIMARY KEY already occupies index 1, so a
# new UNIQUE takes index 2 - the same as if it had been written in the
# CREATE TABLE.
reset_db
do_execsql_test 2.5 {
  CREATE TABLE t1(a INT PRIMARY KEY, b) WITHOUT ROWID;
  INSERT INTO t1 VALUES(1,'x');
  ALTER TABLE t1 ADD CONSTRAINT u1 UNIQUE(b);
  SELECT name, origin FROM pragma_index_list('t1') ORDER BY name;
} {sqlite_autoindex_t1_1 pk sqlite_autoindex_t1_2 u}
do_execsql_test 2.6 { PRAGMA integrity_check } {ok}

# A PRIMARY KEY on a STRICT table implies NOT NULL on its columns.
reset_db
do_execsql_test 2.7 {
  CREATE TABLE t1(a TEXT, b INT) STRICT;
  INSERT INTO t1 VALUES('k',1);
  ALTER TABLE t1 ADD CONSTRAINT p1 PRIMARY KEY(a);
  SELECT name, "notnull", pk FROM pragma_table_info('t1');
} {a 1 1 b 0 0}
do_execsql_test 2.8 { PRAGMA integrity_check } {ok}

#-------------------------------------------------------------------------
# FOREIGN KEY.  Text only - no index, no row rewrite.
#
reset_db
do_execsql_test 3.0 {
  CREATE TABLE p1(k INT PRIMARY KEY);
  CREATE TABLE c1(x INT, y);
  ALTER TABLE c1 ADD CONSTRAINT f1 FOREIGN KEY(x) REFERENCES p1(k) ON DELETE CASCADE;
  SELECT sql FROM sqlite_schema WHERE name='c1';
} {{CREATE TABLE c1(x INT, y, CONSTRAINT f1 FOREIGN KEY(x) REFERENCES p1(k) ON DELETE CASCADE)}}
do_execsql_test 3.1 {
  SELECT id, seq, "table", "from", "to", on_delete
    FROM pragma_foreign_key_list('c1');
} {0 0 p1 x k CASCADE}
do_execsql_test 3.2 {
  SELECT count(*) FROM sqlite_schema WHERE type='index';
} {1}

# With foreign keys enforced, rows that already break the new key are
# reported and the ALTER is rolled back.
reset_db
do_execsql_test 3.3 {
  PRAGMA foreign_keys=ON;
  CREATE TABLE p1(k INT PRIMARY KEY);
  CREATE TABLE c1(x);
  INSERT INTO c1 VALUES(99);
}
do_catchsql_test 3.4 {
  ALTER TABLE c1 ADD CONSTRAINT f1 FOREIGN KEY(x) REFERENCES p1(k);
} {1 {foreign key constraint f1 on c1 failed}}
do_execsql_test 3.5 {
  SELECT sql FROM sqlite_schema WHERE name='c1';
} {{CREATE TABLE c1(x)}}

# With them off, the same ALTER goes through - the rule is the one that
# decides whether an INSERT would be checked.
reset_db
do_execsql_test 3.6 {
  PRAGMA foreign_keys=OFF;
  CREATE TABLE p1(k INT PRIMARY KEY);
  CREATE TABLE c1(x);
  INSERT INTO c1 VALUES(99);
  ALTER TABLE c1 ADD CONSTRAINT f1 FOREIGN KEY(x) REFERENCES p1(k);
  SELECT sql FROM sqlite_schema WHERE name='c1';
} {{CREATE TABLE c1(x, CONSTRAINT f1 FOREIGN KEY(x) REFERENCES p1(k))}}

#-------------------------------------------------------------------------
# DEFAULT.  The five forms a CREATE TABLE accepts, and no more.
#
reset_db
do_execsql_test 4.0 {
  CREATE TABLE t1(a,b,c,d,e);
  ALTER TABLE t1 COLUMN a ADD DEFAULT 5;
  ALTER TABLE t1 COLUMN b ADD DEFAULT -1;
  ALTER TABLE t1 COLUMN c ADD DEFAULT (2+3);
  ALTER TABLE t1 COLUMN d ADD DEFAULT 'q';
  ALTER TABLE t1 COLUMN e ADD DEFAULT TRUE;
  SELECT sql FROM sqlite_schema;
} {{CREATE TABLE t1(a DEFAULT 5,b DEFAULT -1,c DEFAULT (2+3),d DEFAULT 'q',e DEFAULT TRUE)}}
do_execsql_test 4.1 {
  SELECT name, coalesce(dflt_value,'~') FROM pragma_table_info('t1');
} {a 5 b -1 c 2+3 d 'q' e TRUE}
do_execsql_test 4.2 {
  INSERT INTO t1 DEFAULT VALUES;
  SELECT quote(a), quote(b), quote(c), quote(d), quote(e) FROM t1;
} {5 -1 5 'q' 1}

# Rows already in the table keep the values they had; a DEFAULT only says
# what to store for an INSERT that leaves the column out.
reset_db
do_execsql_test 4.3 {
  CREATE TABLE t1(a, b);
  INSERT INTO t1 VALUES(1, NULL);
  ALTER TABLE t1 COLUMN b ADD DEFAULT 'z';
  SELECT a, quote(b) FROM t1;
} {1 NULL}
do_execsql_test 4.4 {
  INSERT INTO t1(a) VALUES(2);
  SELECT a, quote(b) FROM t1 ORDER BY a;
} {1 NULL 2 'z'}

#-------------------------------------------------------------------------
# A converted table is indistinguishable from one created that way.
#
reset_db
do_execsql_test 5.0 {
  CREATE TABLE t2(a,b);
  ALTER TABLE t2 ADD CONSTRAINT n UNIQUE(a);
  CREATE TABLE t3(a,b, CONSTRAINT n UNIQUE(a));
  SELECT (SELECT replace(sql,'t2','X') FROM sqlite_schema WHERE name='t2')
      == (SELECT replace(sql,'t3','X') FROM sqlite_schema WHERE name='t3');
} {1}

# DROP CONSTRAINT refuses to take a UNIQUE or PRIMARY KEY off a table, and
# refuses it just the same whichever way the constraint got there.
do_catchsql_test 5.1 {
  ALTER TABLE t2 DROP CONSTRAINT n;
} {1 {constraint may not be dropped: n}}
do_catchsql_test 5.2 {
  ALTER TABLE t3 DROP CONSTRAINT n;
} {1 {constraint may not be dropped: n}}

# A CHECK or a FOREIGN KEY does come off again, giving back the statement
# the table started with.
reset_db
do_execsql_test 5.3 {
  CREATE TABLE p1(k INT PRIMARY KEY);
  CREATE TABLE t1(a, b);
  ALTER TABLE t1 ADD CONSTRAINT f1 FOREIGN KEY(a) REFERENCES p1(k);
  ALTER TABLE t1 DROP CONSTRAINT f1;
  SELECT sql FROM sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a, b)}}

#-------------------------------------------------------------------------
# Refusals.  Each leaves the schema as it was.
#
reset_db
do_catchsql_test 6.0 {
  CREATE TABLE t1(a INTEGER, b);
  ALTER TABLE t1 ADD CONSTRAINT p1 PRIMARY KEY(a);
} {1 {cannot add an INTEGER PRIMARY KEY to table "t1": column "a" would become an alias for the rowid}}
do_execsql_test 6.1 {
  SELECT sql FROM sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a INTEGER, b)}}

# "INT" is not "INTEGER", so that one is an ordinary indexed PRIMARY KEY.
reset_db
do_execsql_test 6.2 {
  CREATE TABLE t1(a INT, b);
  ALTER TABLE t1 ADD CONSTRAINT p1 PRIMARY KEY(a);
  SELECT name, origin FROM pragma_index_list('t1');
} {sqlite_autoindex_t1_1 pk}

reset_db
do_catchsql_test 6.3 {
  CREATE TABLE t1(a TEXT PRIMARY KEY, b);
  ALTER TABLE t1 ADD CONSTRAINT p1 PRIMARY KEY(b);
} {1 {table "t1" has more than one primary key}}

reset_db
do_catchsql_test 6.4 {
  CREATE TABLE t1(a);
  INSERT INTO t1 VALUES(1),(1);
  ALTER TABLE t1 ADD CONSTRAINT u1 UNIQUE(a);
} {1 {UNIQUE constraint failed: t1.a}}
do_execsql_test 6.5 {
  SELECT (SELECT sql FROM sqlite_schema WHERE name='t1'), count(*) FROM t1;
} {{CREATE TABLE t1(a)} 2}

reset_db
do_catchsql_test 6.6 {
  CREATE TABLE t1(a, CONSTRAINT n1 CHECK(a>0));
  ALTER TABLE t1 ADD CONSTRAINT n1 UNIQUE(a);
} {1 {constraint n1 already exists}}

reset_db
do_catchsql_test 6.7 {
  CREATE TABLE t1(a AS (1), b);
  ALTER TABLE t1 COLUMN a ADD DEFAULT 5;
} {1 {cannot use DEFAULT on a generated column}}

reset_db
do_catchsql_test 6.8 {
  CREATE TABLE t1(a DEFAULT 1, b);
  ALTER TABLE t1 COLUMN a ADD DEFAULT 5;
} {1 {column "a" already has a default value}}

reset_db
do_catchsql_test 6.9 {
  CREATE TABLE t1(a, b);
  ALTER TABLE t1 COLUMN a ADD DEFAULT (b+1);
} {1 {default value of column [a] is not constant}}

do_catchsql_test 6.10 {
  ALTER TABLE t1 COLUMN zz ADD DEFAULT 1;
} {1 {no such column: zz}}

do_catchsql_test 6.11 {
  ALTER TABLE t1 ADD CONSTRAINT u1 UNIQUE(zz);
} {1 {no such column: zz}}

do_catchsql_test 6.12 {
  ALTER TABLE t1 ADD CONSTRAINT p1 PRIMARY KEY(a AUTOINCREMENT);
} {1 {AUTOINCREMENT is only allowed on an INTEGER PRIMARY KEY}}

# A PRIMARY KEY on a STRICT table would make its columns NOT NULL, and
# nothing would recheck the rows, so a NULL in one of them is refused.
reset_db
do_catchsql_test 6.13 {
  CREATE TABLE t1(a TEXT, b INT) STRICT;
  INSERT INTO t1 VALUES(NULL,1);
  ALTER TABLE t1 ADD CONSTRAINT p1 PRIMARY KEY(a);
} {1 {PRIMARY KEY p1 on t1 would be NULL}}
do_execsql_test 6.14 {
  SELECT sql FROM sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a TEXT, b INT) STRICT}}

reset_db
do_catchsql_test 6.15 {
  CREATE VIEW v1 AS SELECT 1 AS a;
  ALTER TABLE v1 ADD CONSTRAINT u1 UNIQUE(a);
} {1 {cannot edit constraints of view "v1"}}

do_catchsql_test 6.16 {
  ALTER TABLE nosuch ADD CONSTRAINT u1 UNIQUE(a);
} {1 {no such table: nosuch}}

# The name is not optional.
do_catchsql_test 6.17 {
  CREATE TABLE t1(a);
  ALTER TABLE t1 ADD UNIQUE(a);
} {1 {near "UNIQUE": syntax error}}

#-------------------------------------------------------------------------
# The temp schema and an attached schema work the same way, and neither
# leaks anything into main.
#
reset_db
do_execsql_test 7.0 {
  CREATE TEMP TABLE t1(a,b);
  INSERT INTO t1 VALUES(1,2);
  ALTER TABLE t1 ADD CONSTRAINT u1 UNIQUE(a);
  SELECT type, name, coalesce(sql,'-') FROM sqlite_temp_schema ORDER BY name;
} {index sqlite_autoindex_t1_1 - table t1 {CREATE TABLE t1(a,b, CONSTRAINT u1 UNIQUE(a))}}
do_execsql_test 7.1 { PRAGMA integrity_check } {ok}
do_execsql_test 7.2 { SELECT count(*) FROM main.sqlite_schema } {0}

reset_db
forcedelete test.db2
do_execsql_test 7.3 {
  ATTACH 'test.db2' AS aux;
  CREATE TABLE aux.t1(a,b);
  ALTER TABLE aux.t1 ADD CONSTRAINT u1 UNIQUE(a);
  SELECT type, name, coalesce(sql,'-') FROM aux.sqlite_schema ORDER BY name;
} {index sqlite_autoindex_t1_1 - table t1 {CREATE TABLE t1(a,b, CONSTRAINT u1 UNIQUE(a))}}
do_execsql_test 7.4 { SELECT count(*) FROM main.sqlite_schema } {0}
do_execsql_test 7.5 { PRAGMA aux.integrity_check } {ok}

#-------------------------------------------------------------------------
# The whole thing - text edit and index alike - is part of the surrounding
# transaction.
#
reset_db
do_execsql_test 8.0 {
  CREATE TABLE t1(a);
  INSERT INTO t1 VALUES(1);
  BEGIN;
  ALTER TABLE t1 ADD CONSTRAINT u1 UNIQUE(a);
  ROLLBACK;
  SELECT type, name FROM sqlite_schema ORDER BY name;
} {table t1}
do_execsql_test 8.1 {
  BEGIN;
  ALTER TABLE t1 ADD CONSTRAINT u1 UNIQUE(a);
  COMMIT;
  SELECT type, name FROM sqlite_schema ORDER BY name;
} {index sqlite_autoindex_t1_1 table t1}
do_execsql_test 8.2 { PRAGMA integrity_check } {ok}

#-------------------------------------------------------------------------
# An invalid stored statement is refused.  A statement that merely
# disagrees with the in-memory schema is not this file's business: ALTER
# TABLE is required to detect a CREATE statement it cannot make sense of,
# not one that is well-formed but out of step with a cache whose freshness
# is the schema cookie's job.
#
# A statement that does not parse at all has nothing to resolve a name
# against.
#
reset_db
do_execsql_test 9.1.0 {
  CREATE TABLE t1(a, b, c NOT NULL);
  PRAGMA writable_schema = 1;
  UPDATE sqlite_schema SET sql = 'CREATE TABLE t1(a, b, c NOT NULL';
  PRAGMA writable_schema = 0;
}
do_catchsql_test 9.1.1 {
  ALTER TABLE t1 ALTER c DROP NOT NULL;
} {1 {database disk image is malformed}}
do_execsql_test 9.1.2 {
  PRAGMA writable_schema = 1;
  SELECT sql FROM sqlite_schema WHERE type='table';
} {{CREATE TABLE t1(a, b, c NOT NULL}}

# A statement that parses but describes a differently named table is caught
# where it always was - by the reload, which will not accept a row whose
# name column and CREATE statement disagree.
#
reset_db
do_execsql_test 9.2.0 {
  CREATE TABLE t1(a, b, c NOT NULL);
  PRAGMA writable_schema = 1;
  UPDATE sqlite_schema SET sql = 'CREATE TABLE t9(a, b, c)';
  PRAGMA writable_schema = 0;
}
do_test 9.2.1 {
  list [catch { execsql {ALTER TABLE t1 ALTER c DROP NOT NULL} } msg] \
       [string match {error in table t1 after drop constraint*} $msg]
} {1 1}
do_execsql_test 9.2.2 {
  PRAGMA writable_schema = 1;
  SELECT sql FROM sqlite_schema WHERE type='table';
} {{CREATE TABLE t9(a, b, c)}}

# 9.3.*: the message that reload failure produces names what the command
# was doing, and a command that adds a constraint says "add constraint"
# whichever of the two routines carried it out.  The mismatched name from
# 9.2 is what makes the reload fail; only the wording is under test.
#
foreach {tn alter word} {
  1 {ALTER TABLE t1 ADD CHECK(a>0)}                 {add constraint}
  2 {ALTER TABLE t1 ADD CONSTRAINT k CHECK(a>0)}    {add constraint}
  3 {ALTER TABLE t1 ADD CONSTRAINT u UNIQUE(a)}     {add constraint}
  4 {ALTER TABLE t1 ADD CONSTRAINT p PRIMARY KEY(a)} {add constraint}
  5 {ALTER TABLE t1 COLUMN a ADD DEFAULT 1}         {add constraint}
  6 {ALTER TABLE t1 ALTER a SET NOT NULL}           {add constraint}
  7 {ALTER TABLE t1 ALTER c DROP NOT NULL}          {drop constraint}
  8 {ALTER TABLE t1 COLUMN a DROP DEFAULT}          {drop constraint}
  9 {ALTER TABLE t1 DROP CHECK}                     {drop constraint}
} {
  reset_db
  db eval {
    CREATE TABLE t1(a, b, c NOT NULL);
    PRAGMA writable_schema = 1;
    UPDATE sqlite_schema SET sql = 'CREATE TABLE t9(a, b, c)';
    PRAGMA writable_schema = 0;
  }
  do_test 9.3.$tn {
    catch { execsql $::alter } msg
    string match "error in table t1 after $::word:*" $msg
  } 1
}

finish_test
