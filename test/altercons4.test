#*************************************************************************
#
# Tests for ALTER TABLE ... ALTER COLUMN {SET|DROP} NOT NULL.
#
# These exercise the path that locates the NOT NULL constraint from the
# extents recorded by the parser (sqlite3NotNullLocAdd()) rather than by
# scanning the CREATE TABLE text.  Cases 1.19 through 1.23 cover columns
# carrying more than one NOT NULL clause, which the scanning
# implementation could not handle.
#

set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix altercons4

# If SQLITE_OMIT_ALTERTABLE is defined, omit this file.
ifcapable !altertable {
  finish_test
  return
}

#-------------------------------------------------------------------------
# Each case: the CREATE TABLE statement, the column to alter, the action,
# the expected schema text afterwards, and the expected "notnull" flag of
# every column, in order.
#
foreach {tn before col act after notnull} {
 1   {CREATE TABLE t1(a INT NOT NULL, b)}
     a    {DROP NOT NULL}
     {CREATE TABLE t1(a INT, b)}
     {00}
 2   {CREATE TABLE t1(a, b INT NOT NULL)}
     b    {DROP NOT NULL}
     {CREATE TABLE t1(a, b INT)}
     {00}
 3   {CREATE TABLE t1(a NOT NULL)}
     a    {DROP NOT NULL}
     {CREATE TABLE t1(a)}
     {0}
 4   {CREATE TABLE t1(a NOT NULL, b NOT NULL, c)}
     b    {DROP NOT NULL}
     {CREATE TABLE t1(a NOT NULL, b, c)}
     {100}
 5   {CREATE TABLE t1(a NOT NULL ON CONFLICT ROLLBACK, b)}
     a    {DROP NOT NULL}
     {CREATE TABLE t1(a, b)}
     {00}
 6   {CREATE TABLE t1(a NOT NULL ON CONFLICT FAIL, b)}
     a    {DROP NOT NULL}
     {CREATE TABLE t1(a, b)}
     {00}
 7   {CREATE TABLE t1(a CONSTRAINT nn NOT NULL, b)}
     a    {DROP NOT NULL}
     {CREATE TABLE t1(a, b)}
     {00}
 8   {CREATE TABLE t1(a CONSTRAINT "n n" NOT NULL, b)}
     a    {DROP NOT NULL}
     {CREATE TABLE t1(a, b)}
     {00}
 9   {CREATE TABLE t1(a NOT NULL DEFAULT 5, b)}
     a    {DROP NOT NULL}
     {CREATE TABLE t1(a DEFAULT 5, b)}
     {00}
 10  {CREATE TABLE t1(a DEFAULT 5 NOT NULL, b)}
     a    {DROP NOT NULL}
     {CREATE TABLE t1(a DEFAULT 5, b)}
     {00}
 11  {CREATE TABLE t1(a CONSTRAINT d DEFAULT 5 NOT NULL, b)}
     a    {DROP NOT NULL}
     {CREATE TABLE t1(a CONSTRAINT d DEFAULT 5, b)}
     {00}
 12  {CREATE TABLE t1(a NOT NULL COLLATE nocase, b)}
     a    {DROP NOT NULL}
     {CREATE TABLE t1(a COLLATE nocase, b)}
     {00}
 13  {CREATE TABLE t1(a NOT NULL CHECK(a>0), b)}
     a    {DROP NOT NULL}
     {CREATE TABLE t1(a CHECK(a>0), b)}
     {00}
 14  {CREATE TABLE t1(a NOT NULL, b, CHECK(a>0))}
     a    {DROP NOT NULL}
     {CREATE TABLE t1(a, b, CHECK(a>0))}
     {00}
 15  {CREATE TABLE t1(a NOT NULL UNIQUE, b)}
     a    {DROP NOT NULL}
     {CREATE TABLE t1(a UNIQUE, b)}
     {00}
 16  {CREATE TABLE t1(a, b)}
     a    {DROP NOT NULL}
     {CREATE TABLE t1(a, b)}
     {00}
 17  {CREATE TABLE t1(a NOT NULL, b CHECK(b<>'NOT NULL'))}
     a    {DROP NOT NULL}
     {CREATE TABLE t1(a, b CHECK(b<>'NOT NULL'))}
     {00}
 18  {CREATE TABLE t1(a DEFAULT 'NOT NULL', b NOT NULL)}
     b    {DROP NOT NULL}
     {CREATE TABLE t1(a DEFAULT 'NOT NULL', b)}
     {00}
 19  {CREATE TABLE t1(a NOT NULL NOT NULL, b)}
     a    {DROP NOT NULL}
     {CREATE TABLE t1(a, b)}
     {00}
 20  {CREATE TABLE t1(a NOT NULL NOT NULL NOT NULL, b)}
     a    {DROP NOT NULL}
     {CREATE TABLE t1(a, b)}
     {00}
 21  {CREATE TABLE t1(a CONSTRAINT x NOT NULL NOT NULL, b)}
     a    {DROP NOT NULL}
     {CREATE TABLE t1(a, b)}
     {00}
 22  {CREATE TABLE t1(a NOT NULL NOT NULL, b, c NOT NULL)}
     c    {DROP NOT NULL}
     {CREATE TABLE t1(a NOT NULL NOT NULL, b, c)}
     {100}
 23  {CREATE TABLE t1(a NOT NULL NOT NULL, b NOT NULL)}
     b    {DROP NOT NULL}
     {CREATE TABLE t1(a NOT NULL NOT NULL, b)}
     {10}
 24  {CREATE TABLE t1(a /*x*/ NOT NULL /*y*/, b)}
     a    {DROP NOT NULL}
     {CREATE TABLE t1(a /*x*/, b)}
     {00}
 25  {CREATE TABLE t1(a/*x*/NOT NULL,b)}
     a    {DROP NOT NULL}
     {CREATE TABLE t1(a/*x*/,b)}
     {00}
 26  {CREATE TABLE t1(a NOT   NULL , b)}
     a    {DROP NOT NULL}
     {CREATE TABLE t1(a, b)}
     {00}
 27  {CREATE TABLE t1(a, b)}
     a    {SET NOT NULL}
     {CREATE TABLE t1(a NOT NULL, b)}
     {10}
 28  {CREATE TABLE t1(a NOT NULL, b)}
     a    {SET NOT NULL}
     {CREATE TABLE t1(a NOT NULL, b)}
     {10}
 29  {CREATE TABLE t1(a NOT NULL NOT NULL, b)}
     a    {SET NOT NULL}
     {CREATE TABLE t1(a NOT NULL, b)}
     {10}
 30  {CREATE TABLE t1(a NOT NULL ON CONFLICT FAIL, b)}
     a    {SET NOT NULL}
     {CREATE TABLE t1(a NOT NULL, b)}
     {10}
} {
  reset_db

  do_execsql_test 1.$tn.0 $before

  do_execsql_test 1.$tn.1 "ALTER TABLE t1 ALTER COLUMN $col $act" {}

  do_execsql_test 1.$tn.2 {
    SELECT sql FROM sqlite_schema WHERE name='t1'
  } [list $after]

  do_execsql_test 1.$tn.3 {
    SELECT group_concat("notnull",'') FROM pragma_table_info('t1')
  } [list $notnull]
}

#-------------------------------------------------------------------------
# A dropped NOT NULL really stops being enforced, even when the column
# definition carried the clause more than once.
#
reset_db
do_execsql_test 2.0 {
  CREATE TABLE t1(a NOT NULL NOT NULL NOT NULL, b);
  ALTER TABLE t1 ALTER COLUMN a DROP NOT NULL;
  INSERT INTO t1 VALUES(NULL, 1);
  SELECT count(*) FROM t1 WHERE a IS NULL;
} {1}

do_execsql_test 2.1 {
  SELECT sql FROM sqlite_schema WHERE name='t1'
} {{CREATE TABLE t1(a, b)}}

#-------------------------------------------------------------------------
# SET NOT NULL collapses any repeated clauses into the single new one.
#
reset_db
do_execsql_test 3.0 {
  CREATE TABLE t1(a NOT NULL NOT NULL, b);
  ALTER TABLE t1 ALTER COLUMN a SET NOT NULL;
  SELECT sql FROM sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a NOT NULL, b)}}

do_catchsql_test 3.1 {
  INSERT INTO t1 VALUES(NULL, 1);
} {1 {NOT NULL constraint failed: t1.a}}

#-------------------------------------------------------------------------
# The same editing works against the temp schema.
#
reset_db
do_execsql_test 4.0 {
  CREATE TEMP TABLE t1(a NOT NULL NOT NULL, b);
  ALTER TABLE t1 ALTER COLUMN a DROP NOT NULL;
  SELECT sql FROM sqlite_temp_schema WHERE name='t1';
} {{CREATE TABLE t1(a, b)}}

#-------------------------------------------------------------------------
# DROP CONSTRAINT by name is unchanged by all of the above.
#
reset_db
do_execsql_test 5.0 {
  CREATE TABLE t1(a CONSTRAINT nn NOT NULL, b);
  ALTER TABLE t1 DROP CONSTRAINT nn;
  SELECT sql FROM sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a, b)}}

do_catchsql_test 5.1 {
  ALTER TABLE t1 DROP CONSTRAINT nosuch;
} {1 {no such constraint: nosuch}}

finish_test
