#*************************************************************************
#
# Tests for ALTER TABLE <table> DROP CONSTRAINT DEFAULT <column>.
#
# A DEFAULT need not have a name, so it is dropped by kind, and it belongs
# to one column, so the column is named instead.  Nothing but the stored
# text changes: no row is rewritten, so a row inserted before the drop
# keeps the value the DEFAULT gave it, and one inserted after gets NULL.
#
# The clause is cut out at the extent the parser recorded during the
# reparse (PARSELOC_Default), so all five ways of writing a DEFAULT are
# removed by the same code, and a "CONSTRAINT <name>" in front of it goes
# with it.  SQLite accepts more than one DEFAULT on a column and lets the
# last one win; all of them are removed.
#
# The column is resolved by name against the stored statement - see
# alterColumnIndex() - which is what sqlite_drop_notnull() does, whose
# implementation this one shares.
#

set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix altercons7

# If SQLITE_OMIT_ALTERTABLE is defined, omit this file.
ifcapable !altertable {
  finish_test
  return
}

#-------------------------------------------------------------------------
# 1.*: what is left in the stored statement.  One case per way of writing
# a DEFAULT, plus the shapes that carry something extra.
#
foreach {tn col before after} {
  1  a { CREATE TABLE t1(a DEFAULT 5, b) }
       { CREATE TABLE t1(a, b) }

  2  a { CREATE TABLE t1(a INT DEFAULT 5, b) }
       { CREATE TABLE t1(a INT, b) }

  3  a { CREATE TABLE t1(a INT DEFAULT (2+3), b) }
       { CREATE TABLE t1(a INT, b) }

  4  a { CREATE TABLE t1(a INT DEFAULT -7, b) }
       { CREATE TABLE t1(a INT, b) }

  5  a { CREATE TABLE t1(a INT DEFAULT +7, b) }
       { CREATE TABLE t1(a INT, b) }

  6  a { CREATE TABLE t1(a TEXT DEFAULT xyz, b) }
       { CREATE TABLE t1(a TEXT, b) }

  7  a { CREATE TABLE t1(a TEXT DEFAULT 'a b', b) }
       { CREATE TABLE t1(a TEXT, b) }

  8  a { CREATE TABLE t1(a CONSTRAINT k DEFAULT 5, b) }
       { CREATE TABLE t1(a, b) }

  9  a { CREATE TABLE t1(a DEFAULT 1 DEFAULT 2, b) }
       { CREATE TABLE t1(a, b) }

  10 a { CREATE TABLE t1(a INT DEFAULT 5 NOT NULL, b) }
       { CREATE TABLE t1(a INT NOT NULL, b) }

  11 a { CREATE TABLE t1(a INT NOT NULL DEFAULT 5, b) }
       { CREATE TABLE t1(a INT NOT NULL, b) }

  12 b { CREATE TABLE t1(a, b DEFAULT current_timestamp) }
       { CREATE TABLE t1(a, b) }

  13 a { CREATE TABLE t1(a DEFAULT 5) }
       { CREATE TABLE t1(a) }

  14 a { CREATE TABLE t1(a DEFAULT 5, b DEFAULT 6) }
       { CREATE TABLE t1(a, b DEFAULT 6) }

  15 {my col} { CREATE TABLE t1("my col" DEFAULT 9, b) }
       { CREATE TABLE t1("my col", b) }

  16 a { CREATE TABLE t1(a INT DEFAULT 5 PRIMARY KEY, b) }
       { CREATE TABLE t1(a INT PRIMARY KEY, b) }

  17 a { CREATE TABLE t1(a INT DEFAULT 5, b, CHECK(b>0)) }
       { CREATE TABLE t1(a INT, b, CHECK(b>0)) }

  18 a { CREATE TABLE t1(a INT DEFAULT NULL, b) }
       { CREATE TABLE t1(a INT, b) }
} {
  reset_db
  do_execsql_test 1.$tn.1 $before
  do_execsql_test 1.$tn.2 "
    ALTER TABLE t1 DROP CONSTRAINT DEFAULT \"$col\";
    SELECT sql FROM sqlite_schema WHERE name='t1';
  " [list [string trim $after]]
  do_execsql_test 1.$tn.3 { PRAGMA integrity_check } {ok}
}

# A leading comment belongs to the column and stays; a trailing one sits
# inside the clause and goes with it.  Same as ALTER ... DROP NOT NULL,
# whose implementation this shares.
#
reset_db
do_execsql_test 1.19.1 {
  CREATE TABLE t1(a INT /*keep*/ DEFAULT 5 /*go*/, b);
  ALTER TABLE t1 DROP CONSTRAINT DEFAULT a;
  SELECT sql FROM sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a INT /*keep*/, b)}}

#-------------------------------------------------------------------------
# 2.*: the result is the table that would have been created without the
# DEFAULT - same columns, same dflt_value, same flags.
#
foreach {tn col before after} {
  1 a { CREATE TABLE t1(a INT DEFAULT 5, b TEXT, c) }
      { CREATE TABLE t1(a INT, b TEXT, c) }

  2 b { CREATE TABLE t1(a, b TEXT DEFAULT 'x' NOT NULL, c) }
      { CREATE TABLE t1(a, b TEXT NOT NULL, c) }

  3 a { CREATE TABLE t1(a INT DEFAULT (1+1), b, c, PRIMARY KEY(b)) }
      { CREATE TABLE t1(a INT, b, c, PRIMARY KEY(b)) }
} {
  set probe {
    SELECT cid, name, type, "notnull", coalesce(dflt_value,'~'), pk
      FROM pragma_table_info('t1');
    SELECT wr, strict, ncol FROM pragma_table_list WHERE name='t1';
    SELECT name FROM pragma_index_list('t1') ORDER BY name;
  }

  reset_db
  execsql $after
  set ref [execsql $probe]

  reset_db
  execsql $before
  do_execsql_test 2.$tn.1 "
    ALTER TABLE t1 DROP CONSTRAINT DEFAULT $col;
    $probe
  " $ref
  do_execsql_test 2.$tn.2 { PRAGMA integrity_check } {ok}
}

#-------------------------------------------------------------------------
# 3.*: nothing is rewritten.  A row that already took the default keeps
# the value; a row inserted afterwards gets NULL.
#
reset_db
do_execsql_test 3.0 {
  CREATE TABLE t1(a INT DEFAULT 5, b);
  INSERT INTO t1(b) VALUES(1);
  INSERT INTO t1 VALUES(99, 2);
}
do_execsql_test 3.1 {
  ALTER TABLE t1 DROP CONSTRAINT DEFAULT a;
  INSERT INTO t1(b) VALUES(3);
  SELECT b, quote(a) FROM t1 ORDER BY b;
} {1 5 2 99 3 NULL}
do_execsql_test 3.2 { PRAGMA integrity_check } {ok}

# Only the named column loses its default.
#
reset_db
do_execsql_test 3.3 {
  CREATE TABLE t1(a DEFAULT 1, b DEFAULT 2);
  ALTER TABLE t1 DROP CONSTRAINT DEFAULT a;
  INSERT INTO t1 DEFAULT VALUES;
  SELECT quote(a), quote(b) FROM t1;
} {NULL 2}

#-------------------------------------------------------------------------
# 4.*: a column with no DEFAULT is left alone rather than refused.  This
# follows postgres, and matches what the named form of DROP CONSTRAINT
# does with an INTEGER-typed argument.
#
reset_db
do_execsql_test 4.1 {
  CREATE TABLE t1(a INT, b);
  ALTER TABLE t1 DROP CONSTRAINT DEFAULT a;
  SELECT sql FROM sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a INT, b)}}

# Twice in a row: the second is the no-op above.
#
reset_db
do_execsql_test 4.2 {
  CREATE TABLE t1(a INT DEFAULT 5, b);
  ALTER TABLE t1 DROP CONSTRAINT DEFAULT a;
  ALTER TABLE t1 DROP CONSTRAINT DEFAULT a;
  SELECT sql FROM sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a INT, b)}}

# A generated column cannot carry a DEFAULT, so there is nothing to drop.
#
ifcapable altertable {
  reset_db
  do_execsql_test 4.3 {
    CREATE TABLE t1(a INT, b AS (a+1));
    ALTER TABLE t1 DROP CONSTRAINT DEFAULT b;
    SELECT sql FROM sqlite_schema WHERE name='t1';
  } {{CREATE TABLE t1(a INT, b AS (a+1))}}
}

#-------------------------------------------------------------------------
# 5.*: refusals.  Nothing is changed by one.
#
reset_db
do_execsql_test 5.0 { CREATE TABLE t1(a INT DEFAULT 5, b) }
do_catchsql_test 5.1 {
  ALTER TABLE t1 DROP CONSTRAINT DEFAULT zz;
} {1 {no such column: zz}}
do_execsql_test 5.2 {
  SELECT sql FROM sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a INT DEFAULT 5, b)}}

do_catchsql_test 5.3 {
  CREATE VIEW v1 AS SELECT 1 AS x;
  ALTER TABLE v1 DROP CONSTRAINT DEFAULT x;
} {1 {cannot edit constraints of view "v1"}}

do_catchsql_test 5.4 {
  ALTER TABLE nosuchtable DROP CONSTRAINT DEFAULT a;
} {1 {no such table: nosuchtable}}

do_catchsql_test 5.5 {
  ALTER TABLE sqlite_schema DROP CONSTRAINT DEFAULT a;
} {1 {table sqlite_master may not be altered}}

#-------------------------------------------------------------------------
# 6.*: the other schemas.
#
reset_db
forcedelete test.db2
do_execsql_test 6.1.0 {
  ATTACH 'test.db2' AS aux;
  CREATE TABLE aux.t1(a INT DEFAULT 5, b);
  INSERT INTO aux.t1(b) VALUES(1);
}
do_execsql_test 6.1.1 {
  ALTER TABLE aux.t1 DROP CONSTRAINT DEFAULT a;
  SELECT sql FROM aux.sqlite_schema WHERE name='t1';
  SELECT quote(a) FROM aux.t1;
} {{CREATE TABLE t1(a INT, b)} 5}
do_execsql_test 6.1.2 { PRAGMA aux.integrity_check } {ok}

reset_db
do_execsql_test 6.2.0 {
  CREATE TEMP TABLE t1(a INT DEFAULT 5, b);
  ALTER TABLE t1 DROP CONSTRAINT DEFAULT a;
  SELECT sql FROM temp.sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a INT, b)}}

# A temp table shadowing one in main: the ALTER reaches the temp one.
#
reset_db
do_execsql_test 6.3.0 {
  CREATE TABLE t1(a INT DEFAULT 5, b);
  CREATE TEMP TABLE t1(a INT DEFAULT 5, b);
  ALTER TABLE t1 DROP CONSTRAINT DEFAULT a;
  SELECT sql FROM temp.sqlite_schema WHERE name='t1';
  SELECT sql FROM main.sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a INT, b)} {CREATE TABLE t1(a INT DEFAULT 5, b)}}

#-------------------------------------------------------------------------
# 7.*: ROLLBACK takes the whole edit with it.
#
reset_db
do_execsql_test 7.1 {
  CREATE TABLE t1(a INT DEFAULT 5, b);
  BEGIN;
    ALTER TABLE t1 DROP CONSTRAINT DEFAULT a;
  ROLLBACK;
  INSERT INTO t1(b) VALUES(1);
  SELECT sql FROM sqlite_schema WHERE name='t1';
  SELECT quote(a) FROM t1;
} {{CREATE TABLE t1(a INT DEFAULT 5, b)} 5}

#-------------------------------------------------------------------------
# 8.*: an invalid stored statement is refused, and left alone.
#
reset_db
do_execsql_test 8.1.0 {
  CREATE TABLE t1(a INT DEFAULT 5, b);
  PRAGMA writable_schema = 1;
  UPDATE sqlite_schema SET sql = 'CREATE TABLE t1(a INT DEFAULT 5, b'
   WHERE name = 't1';
  PRAGMA writable_schema = 0;
}
do_catchsql_test 8.1.1 {
  ALTER TABLE t1 DROP CONSTRAINT DEFAULT a;
} {1 {database disk image is malformed}}
do_execsql_test 8.1.2 {
  PRAGMA writable_schema = 1;
  SELECT sql FROM sqlite_schema WHERE type='table';
} {{CREATE TABLE t1(a INT DEFAULT 5, b}}

finish_test
