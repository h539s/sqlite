set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix altercons2

# If SQLITE_OMIT_ALTERTABLE is defined, omit this file.
ifcapable !altertable {
  finish_test
  return
}

# These cases corrupt the stored CREATE TABLE with writable_schema and then
# run an ALTER against it.
#
# The constraint editors decide what to do from the in-memory Table but edit
# the text held in sqlite_schema.  Before touching that text they reparse it
# and check the result against the live table, so a statement that does not
# parse - or that parses into something other than the table the command was
# planned against - is refused and the text is left alone.  Every case here
# is therefore reported as corruption, with the stored text untouched.
#
# Cases 2, 3 and 4 used to be answered differently: the scanner they replaced
# looked for a NOT NULL, did not find one in the broken text, and reported
# success.  In case 4 it went further and removed a NOT NULL from a statement
# with no closing parenthesis.  Refusing is the safer answer, and the only
# one available to an editor that works from a parse.
#
foreach {tn newsql alter res final} {
  1 "CREATE TABLE t1(a, b"
    "ALTER TABLE t1 ALTER COLUMN c ADD NOT NULL"
    {1 {database disk image is malformed}}
    "CREATE TABLE t1(a, b"

  2 "CREATE TABLE t1(a, b, "
    "ALTER TABLE t1 ALTER COLUMN c DROP NOT NULL"
    {1 {database disk image is malformed}}
    "CREATE TABLE t1(a, b, "

  3 "CREATE TABLE t1(a, b, CHECK( ..."
    "ALTER TABLE t1 ALTER COLUMN c DROP NOT NULL"
    {1 {database disk image is malformed}}
    "CREATE TABLE t1(a, b, CHECK( ..."

  4 "CREATE TABLE t1(a, b, c NOT NULL"
    "ALTER TABLE t1 ALTER COLUMN c DROP NOT NULL"
    {1 {database disk image is malformed}}
    "CREATE TABLE t1(a, b, c NOT NULL"

  5 "CREATE TABLE"
    "ALTER TABLE t1 ALTER COLUMN c DROP NOT NULL"
    {1 {database disk image is malformed}}
    "CREATE TABLE"

  6 "CREATE TABLE"
    "ALTER TABLE t1 ADD CHECK nn (a!=0)"
    {1 {database disk image is malformed}}
    "CREATE TABLE"

} {
  reset_db
  do_execsql_test 1.$tn.0 {
    CREATE TABLE t1(a, b, c NOT NULL, CONSTRAINT xyz CHECK( a!=0 ));
  }
  do_execsql_test 1.$tn.1 {
    PRAGMA writable_schema = 1;
    UPDATE sqlite_schema SET sql = $::newsql
  }
  do_catchsql_test 1.$tn.2 $alter $res

  do_execsql_test 1.$tn.3 {
    SELECT sql FROM sqlite_schema WHERE name='t1'
  } [list $final]
}

#-------------------------------------------------------------------------

reset_db
proc xAuth {t args} {
  if {$t=="SQLITE_ALTER_TABLE"} {
    return "SQLITE_DENY"
  }
  return "SQLITE_OK"
}
sqlite3 db test.db
db auth xAuth

do_execsql_test 2.0 {
  CREATE TABLE x1(a PRIMARY KEY, b CHECK(a!=b) NOT NULL, c);
}

do_catchsql_test 2.1.1 {
  ALTER TABLE x1 ADD CHECK ccc (a!='a')
} {1 {not authorized}}
do_execsql_test 2.1.2 {
  SELECT sql FROM sqlite_schema WHERE name='x1'
} {{CREATE TABLE x1(a PRIMARY KEY, b CHECK(a!=b) NOT NULL, c)}}

do_catchsql_test 2.2.1 {
  ALTER TABLE x1 ALTER COLUMN c ADD NOT NULL
} {1 {not authorized}}
do_execsql_test 2.2.2 {
  SELECT sql FROM sqlite_schema WHERE name='x1'
} {{CREATE TABLE x1(a PRIMARY KEY, b CHECK(a!=b) NOT NULL, c)}}

#-------------------------------------------------------------------------
reset_db
do_execsql_test 3.0 {
  CREATE TABLE t1(x);
}
do_execsql_test 3.1 {
  ALTER TABLE t1 ALTER COLUMN x ADD NOT NULL;
}

#-------------------------------------------------------------------------
reset_db
# Only the CONSTRAINT clause that sits immediately in front of a constraint
# names it, so this CHECK is called "two" and nothing is called "one".
do_execsql_test 4.0 {
  CREATE TABLE abc(a, b, c, CONSTRAINT one CONSTRAINT two CHECK (b!=c));
}
do_catchsql_test 4.1 {
  ALTER TABLE abc DROP CHECK one
} {1 {no such CHECK constraint: one}}
do_execsql_test 4.2 {
  ALTER TABLE abc DROP CHECK two
}
do_execsql_test 4.3 {
  SELECT sql FROM sqlite_schema
} {
  {CREATE TABLE abc(a, b, c, CONSTRAINT one)}
}

#-------------------------------------------------------------------------
reset_db

# The columns must come before the table constraints in a CREATE TABLE
# statement. This is useful, as it means the constraint editors do not have
# to handle a constraint immediately following the '(' at the start of the
# column-list.
do_catchsql_test 5.0 {
  CREATE TABLE abc(a, b, c, CONSTRAINT two CHECK (b!=c), d)
} {1 {near "d": syntax error}}
do_catchsql_test 5.1 {
  CREATE TABLE def(CONSTRAINT abc CHECK( b!=c ), a, b, c);
} {1 {near "CONSTRAINT": syntax error}}

#-------------------------------------------------------------------------
reset_db
do_execsql_test 6.0 {
  CREATE TABLE abc(a, b CONSTRAINT two COLLATE nocase CHECK (a!=b), c CONSTRAINT one DEFAULT 'abc');
}

# The CHECK is not named "two": "COLLATE nocase" comes between them, so the
# name belongs to that instead.  The DEFAULT does carry the name "one", and
# leaves with it.
do_execsql_test 6.1 {
  ALTER TABLE abc DROP CHECK;
  ALTER TABLE abc COLUMN c DROP DEFAULT;
}

do_execsql_test 6.2 {
  SELECT sql FROM sqlite_schema
} {
  {CREATE TABLE abc(a, b CONSTRAINT two COLLATE nocase, c)}
}

#-------------------------------------------------------------------------
reset_db
do_execsql_test 7.0 {
  CREATE TABLE abc(a, b, c, CONSTRAINT one CHECK (a>b) FOREIGN KEY(a) REFERENCES abc);
}
do_execsql_test 7.1 {
  ALTER TABLE abc DROP CHECK one
}
do_execsql_test 7.2 {
  SELECT sql FROM sqlite_schema
} {
  {CREATE TABLE abc(a, b, c, FOREIGN KEY(a) REFERENCES abc)}
}

#-------------------------------------------------------------------------
reset_db
do_execsql_test 8.0 {
  CREATE TABLE abc(a, b, c, CONSTRAINT one FOREIGN KEY(a) REFERENCES abc);
}
# A FOREIGN KEY is asked for by what it says, so its name makes no
# difference to the request and leaves with the clause.
do_catchsql_test 8.1 {
  ALTER TABLE abc DROP FOREIGN KEY(a) REFERENCES abc
} {0 {}}
do_execsql_test 8.2 {
  SELECT sql FROM sqlite_schema
} {{CREATE TABLE abc(a, b, c)}}

#-------------------------------------------------------------------------
reset_db
do_execsql_test 9.0 {
  CREATE TABLE abc(a, b NOT NULL AS (a+1))
}
do_execsql_test 9.1 {
  ALTER TABLE abc ALTER COLUMN b DROP NOT NULL;
  SELECT sql FROM sqlite_schema;
} {{CREATE TABLE abc(a, b AS (a+1))}}

#-------------------------------------------------------------------------
reset_db
do_execsql_test 10.0 {
  CREATE TABLE abc(a, b GENERATED ALWAYS AS (a+1));
  INSERT INTO abc VALUES(1), (2);
  SELECT * FROM abc;
} {1 2   2 3}

do_execsql_test 10.1 {
  ALTER TABLE abc ALTER COLUMN b ADD NOT NULL;
}
do_catchsql_test 10.2 {
  INSERT INTO abc VALUES(NULL);
} {1 {NOT NULL constraint failed: abc.b}}
do_execsql_test 10.3 {
  INSERT INTO abc VALUES(3);
  ALTER TABLE abc ALTER COLUMN b DROP NOT NULL;
}
do_execsql_test 10.4 {
  INSERT INTO abc VALUES(NULL);
}

#-------------------------------------------------------------------------
reset_db
do_execsql_test 11.0 {
  CREATE TABLE t1(a, b, c);
}

do_execsql_test 11.1.1 {
  ALTER TABLE t1 ADD CHECK c1(a=b) --comment
  ;
}

do_execsql_test 11.1.2 {ALTER TABLE t1 ADD CHECK c2(a=b) --comment}

do_execsql_test 11.1.3 {
  SELECT sql FROM sqlite_schema;
} {
  {CREATE TABLE t1(a, b, c, CONSTRAINT c1 CHECK (a=b), CONSTRAINT c2 CHECK (a=b))}
}

do_execsql_test 11.2.1 {
  CREATE TABLE t2(a, b);
}
do_execsql_test 11.2.2 {ALTER TABLE t2 ALTER COLUMN b ADD NOT NULL --new cons}
do_execsql_test 11.2.3 {
  SELECT sql FROM sqlite_schema WHERE name='t2';
} {
  {CREATE TABLE t2(a, b NOT NULL)}
}
do_execsql_test 11.2.3 {
  ALTER TABLE t2 ALTER COLUMN b DROP NOT NULL;
  SELECT sql FROM sqlite_schema WHERE name='t2';
} {
  {CREATE TABLE t2(a, b)}
}
do_execsql_test 11.2.2 {ALTER TABLE t2 ALTER COLUMN b ADD NOT NULL --new cons
;
}

#-------------------------------------------------------------------------
reset_db
do_execsql_test 12.0 {
  CREATE TABLE "Test" ( 
      "IsActive" INTEGER, 
      CONSTRAINT "BooleanZeroOrOne" CHECK ("IsActive" IN (0, 1)) 
  );
}

do_execsql_test 12.1 {
  ALTER TABLE Test DROP CHECK BooleanZeroOrOne
}

do_execsql_test 12.2 {
  SELECT sql FROM sqlite_schema
} {
  {CREATE TABLE "Test" ( 
      "IsActive" INTEGER)}
}

do_execsql_test 12.3 {
  DROP TABLE Test;
  CREATE TABLE "Test" ( 
      "IsActive" INTEGER, 
      CONSTRAINT "BooleanZeroOrOne" CHECK ("IsActive" IN (0, 1)) 
  );
}

do_execsql_test 12.4 {
  ALTER TABLE Test DROP CHECK "BooleanZeroOrOne"
}

do_execsql_test 12.5 {
  SELECT sql FROM sqlite_schema
} {
  {CREATE TABLE "Test" ( 
      "IsActive" INTEGER)}
}

do_execsql_test 12.6 {
  CREATE TABLE t1(a, b CONSTRAINT "a""b" CHECK (b IS NOT NULL));
}

do_execsql_test 12.7 {
  ALTER TABLE t1 DROP CHECK "a""b"
}

finish_test

