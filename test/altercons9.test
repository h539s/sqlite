#*************************************************************************
#
# Tests for
#
#   ALTER TABLE <table> [COLUMN <column>] DROP CHECK
#
# The two forms partition the table's CHECK constraints by where each one
# was written.  Naming a column removes the CHECKs written inside that
# column's definition; naming none removes the CHECKs written at table
# level, after the column list.  Neither reaches the other's.
#
# Where a CHECK was written is all there is to go on.  SQLite draws no
# distinction between the two places: Table.pCheck is a flat list with no
# column recorded against an entry, a CHECK written on a column may refer
# to any column of the table, and it is enforced exactly as a table-level
# one is.  So a table-level CHECK that mentions a column is not that
# column's, and a column-level CHECK that mentions a different column
# still is.  The parser records which it was (PARSELOC_Check), and that
# is what these two forms go by.
#
# COLUMN is required: "ALTER TABLE t c DROP CHECK" is a syntax error.
#
# A CHECK need not have a name, so there is nothing to reach by name; and
# because the extent is recorded rather than searched for, an ON CONFLICT
# clause and a "CONSTRAINT <name>" leave with the constraint.
#

set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix altercons9

# If SQLITE_OMIT_ALTERTABLE is defined, omit this file.
ifcapable !altertable {
  finish_test
  return
}
ifcapable !check {
  finish_test
  return
}

#-------------------------------------------------------------------------
# 1.*: no column named - the CHECKs written at table level go, and only
# those.  A CHECK written inside a column definition stays, whatever it
# mentions.
#
foreach {tn before after} {
  1 { CREATE TABLE t1(a, b, CHECK(a>0)) }
    { CREATE TABLE t1(a, b) }

  2 { CREATE TABLE t1(a CHECK(a>0), b) }
    { CREATE TABLE t1(a CHECK(a>0), b) }

  3 { CREATE TABLE t1(a CHECK(a>0), b CHECK(b>0), CHECK(a<b)) }
    { CREATE TABLE t1(a CHECK(a>0), b CHECK(b>0)) }

  4 { CREATE TABLE t1(a, b, CONSTRAINT k CHECK(a>0)) }
    { CREATE TABLE t1(a, b) }

  5 { CREATE TABLE t1(a CONSTRAINT k CHECK(a>0), b) }
    { CREATE TABLE t1(a CONSTRAINT k CHECK(a>0), b) }

  6 { CREATE TABLE t1(a, b, CHECK(a>0) ON CONFLICT FAIL) }
    { CREATE TABLE t1(a, b) }

  7 { CREATE TABLE t1(a, b, CHECK(a>0), UNIQUE(b), CHECK(b>0)) }
    { CREATE TABLE t1(a, b, UNIQUE(b)) }

  8 { CREATE TABLE t1(a CHECK(b>0), b, CHECK(a>0)) }
    { CREATE TABLE t1(a CHECK(b>0), b) }

  9 { CREATE TABLE t1(a, b, CHECK(a>0), CHECK(b>0), CHECK(a<b)) }
    { CREATE TABLE t1(a, b) }

  10 { CREATE TABLE t1(a, b) }
     { CREATE TABLE t1(a, b) }

  11 { CREATE TABLE t1(a INT NOT NULL DEFAULT 5, b, CHECK(a IN (1,2,3))) }
     { CREATE TABLE t1(a INT NOT NULL DEFAULT 5, b) }

  12 { CREATE TABLE t1(a, b, CHECK(a>0) /*go*/) }
     { CREATE TABLE t1(a, b) }

  13 { CREATE TABLE t1(a, CHECK(a>0)) }
     { CREATE TABLE t1(a) }
} {
  # No column may be lost along the way: compare against the table that
  # would have been created without the constraints in the first place.
  reset_db
  execsql $after
  set ref [execsql {
    SELECT cid, name, type, "notnull", coalesce(dflt_value,'~'), pk
      FROM pragma_table_info('t1')
  }]

  reset_db
  do_execsql_test 1.$tn.1 $before
  do_execsql_test 1.$tn.2 {
    ALTER TABLE t1 DROP CHECK;
    SELECT sql FROM sqlite_schema WHERE name='t1';
  } [list [string trim $after]]
  do_execsql_test 1.$tn.3 { PRAGMA integrity_check } {ok}
  do_execsql_test 1.$tn.4 {
    SELECT cid, name, type, "notnull", coalesce(dflt_value,'~'), pk
      FROM pragma_table_info('t1')
  } $ref
}

#-------------------------------------------------------------------------
# 2.*: a column named - only what was written inside that column goes.
#
foreach {tn col before after} {
  1 a { CREATE TABLE t1(a CHECK(a>0), b CHECK(b>0)) }
      { CREATE TABLE t1(a, b CHECK(b>0)) }

  2 b { CREATE TABLE t1(a CHECK(a>0), b CHECK(b>0)) }
      { CREATE TABLE t1(a CHECK(a>0), b) }

  3 a { CREATE TABLE t1(a CHECK(a>0) CHECK(a<9), b) }
      { CREATE TABLE t1(a, b) }

  4 a { CREATE TABLE t1(a CONSTRAINT k CHECK(a>0), b) }
      { CREATE TABLE t1(a, b) }

  5 a { CREATE TABLE t1(a INT CHECK(a>0) NOT NULL, b) }
      { CREATE TABLE t1(a INT NOT NULL, b) }

  6 a { CREATE TABLE t1(a CHECK(a>0), b) }
      { CREATE TABLE t1(a, b) }

  7 a { CREATE TABLE t1(a, b) }
      { CREATE TABLE t1(a, b) }
} {
  reset_db
  do_execsql_test 2.$tn.1 $before
  do_execsql_test 2.$tn.2 "
    ALTER TABLE t1 COLUMN $col DROP CHECK;
    SELECT sql FROM sqlite_schema WHERE name='t1';
  " [list [string trim $after]]
  do_execsql_test 2.$tn.3 { PRAGMA integrity_check } {ok}
}

#-------------------------------------------------------------------------
# 3.*: neither form reaches the other's.  Where the constraint was
# written decides, not what it mentions.
#
foreach {tn alter before after} {
  1 {COLUMN a DROP CHECK}
    { CREATE TABLE t1(a, b, CHECK(a>0)) }
    { CREATE TABLE t1(a, b, CHECK(a>0)) }

  2 {DROP CHECK}
    { CREATE TABLE t1(a CHECK(a>0), b) }
    { CREATE TABLE t1(a CHECK(a>0), b) }

  3 {COLUMN a DROP CHECK}
    { CREATE TABLE t1(a CHECK(a>0), b, CHECK(a<9)) }
    { CREATE TABLE t1(a, b, CHECK(a<9)) }

  4 {DROP CHECK}
    { CREATE TABLE t1(a CHECK(a>0), b, CHECK(a<9)) }
    { CREATE TABLE t1(a CHECK(a>0), b) }

  5 {COLUMN a DROP CHECK}
    { CREATE TABLE t1(a CHECK(b>0), b) }
    { CREATE TABLE t1(a, b) }

  6 {COLUMN b DROP CHECK}
    { CREATE TABLE t1(a CHECK(b>0), b) }
    { CREATE TABLE t1(a CHECK(b>0), b) }
} {
  reset_db
  do_execsql_test 3.$tn.1 $before
  do_execsql_test 3.$tn.2 "
    ALTER TABLE t1 $alter;
    SELECT sql FROM sqlite_schema WHERE name='t1';
  " [list [string trim $after]]
}

# Together the two forms cover everything, and the order does not matter.
#
foreach {tn order} {
  1 {{DROP CHECK} {COLUMN a DROP CHECK} {COLUMN b DROP CHECK}}
  2 {{COLUMN b DROP CHECK} {COLUMN a DROP CHECK} {DROP CHECK}}
  3 {{COLUMN a DROP CHECK} {DROP CHECK} {COLUMN b DROP CHECK}}
} {
  reset_db
  execsql { CREATE TABLE t1(a CHECK(a>0), b CHECK(b>0), CHECK(a<b)) }
  foreach alt $order { execsql "ALTER TABLE t1 $alt" }
  do_execsql_test 3.10.$tn {
    SELECT sql FROM sqlite_schema WHERE name='t1';
  } {{CREATE TABLE t1(a, b)}}
}

# Why "where it was written" is the only rule available: SQLite enforces a
# CHECK the same way wherever it sits, so a CHECK on "a" that talks only
# about "b" is not "b"'s in any sense the engine knows about.
#
reset_db
do_execsql_test 3.11.1 {
  CREATE TABLE t1(a CHECK(b>0), b);
}
do_catchsql_test 3.11.2 {
  INSERT INTO t1 VALUES(1, -5);
} {1 {CHECK constraint failed: b>0}}

#-------------------------------------------------------------------------
# 4.*: the result is the table that would have been created without the
# constraints that went.
#
foreach {tn alter before after} {
  1 {DROP CHECK}
    { CREATE TABLE t1(a INT, b TEXT, c, CHECK(c IS NOT NULL)) }
    { CREATE TABLE t1(a INT, b TEXT, c) }

  2 {COLUMN a DROP CHECK}
    { CREATE TABLE t1(a INT CHECK(a>0), b TEXT, c, UNIQUE(b)) }
    { CREATE TABLE t1(a INT, b TEXT, c, UNIQUE(b)) }
} {
  set probe {
    SELECT cid, name, type, "notnull", coalesce(dflt_value,'~'), pk
      FROM pragma_table_info('t1');
    SELECT name, "unique" FROM pragma_index_list('t1') ORDER BY name;
    SELECT wr, strict, ncol FROM pragma_table_list WHERE name='t1';
  }

  reset_db
  execsql $after
  set ref [execsql $probe]

  reset_db
  execsql $before
  do_execsql_test 4.$tn.1 "
    ALTER TABLE t1 $alter;
    $probe
  " $ref
  do_execsql_test 4.$tn.2 { PRAGMA integrity_check } {ok}
}

#-------------------------------------------------------------------------
# 5.*: the rows are untouched, what went no longer bites, and what stayed
# still does.
#
reset_db
do_execsql_test 5.1 {
  CREATE TABLE t1(a CHECK(a>0), b CHECK(b>0));
  INSERT INTO t1 VALUES(5, 5);
}
do_catchsql_test 5.2 {
  INSERT INTO t1 VALUES(-1, 5);
} {1 {CHECK constraint failed: a>0}}
do_execsql_test 5.3 {
  ALTER TABLE t1 COLUMN a DROP CHECK;
  INSERT INTO t1 VALUES(-1, 5);
  SELECT a, b FROM t1 ORDER BY a;
} {-1 5 5 5}
do_catchsql_test 5.4 {
  INSERT INTO t1 VALUES(1, -5);
} {1 {CHECK constraint failed: b>0}}
do_execsql_test 5.5 { PRAGMA integrity_check } {ok}

# The table-level form, and that it leaves the column-level one enforcing.
#
reset_db
do_execsql_test 5.6 {
  CREATE TABLE t1(a CHECK(a>0), b, CHECK(b>0));
  ALTER TABLE t1 DROP CHECK;
  INSERT INTO t1 VALUES(1, -5);
  SELECT count(*) FROM t1;
} {1}
do_catchsql_test 5.7 {
  INSERT INTO t1 VALUES(-1, 5);
} {1 {CHECK constraint failed: a>0}}

#-------------------------------------------------------------------------
# 6.*: nothing to drop is a no-op rather than an error, in either form.
#
reset_db
do_execsql_test 6.1 {
  CREATE TABLE t1(a, b);
  ALTER TABLE t1 DROP CHECK;
  ALTER TABLE t1 COLUMN a DROP CHECK;
  SELECT sql FROM sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a, b)}}

# A table whose only CHECKs are the other form's.
#
reset_db
do_execsql_test 6.2 {
  CREATE TABLE t1(a CHECK(a>0), b);
  ALTER TABLE t1 DROP CHECK;
  SELECT sql FROM sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a CHECK(a>0), b)}}

# Twice in a row.
#
reset_db
do_execsql_test 6.3 {
  CREATE TABLE t1(a, b, CHECK(a>0));
  ALTER TABLE t1 DROP CHECK;
  ALTER TABLE t1 DROP CHECK;
  SELECT sql FROM sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a, b)}}

#-------------------------------------------------------------------------
# 7.*: refusals.  Nothing is changed by one.
#
reset_db
do_execsql_test 7.0 { CREATE TABLE t1(a CHECK(a>0), b, CHECK(b>0)) }

# COLUMN is required - a bare column name is a syntax error.
#
do_catchsql_test 7.1 {
  ALTER TABLE t1 a DROP CHECK;
} {1 {near "a": syntax error}}

do_catchsql_test 7.2 {
  ALTER TABLE t1 COLUMN zz DROP CHECK;
} {1 {no such column: zz}}
do_execsql_test 7.3 {
  SELECT sql FROM sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a CHECK(a>0), b, CHECK(b>0))}}

do_catchsql_test 7.4 {
  CREATE VIEW v1 AS SELECT 1 AS x;
  ALTER TABLE v1 DROP CHECK;
} {1 {cannot edit constraints of view "v1"}}

do_catchsql_test 7.5 {
  ALTER TABLE v1 COLUMN x DROP CHECK;
} {1 {cannot edit constraints of view "v1"}}

do_catchsql_test 7.6 {
  ALTER TABLE nosuchtable DROP CHECK;
} {1 {no such table: nosuchtable}}

do_catchsql_test 7.7 {
  ALTER TABLE sqlite_schema DROP CHECK;
} {1 {table sqlite_master may not be altered}}

#-------------------------------------------------------------------------
# 8.*: the other schemas, and ROLLBACK.
#
reset_db
forcedelete test.db2
do_execsql_test 8.1.0 {
  ATTACH 'test.db2' AS aux;
  CREATE TABLE aux.t1(a CHECK(a>0), b, CHECK(b>0));
  INSERT INTO aux.t1 VALUES(1, 2);
}
do_execsql_test 8.1.1 {
  ALTER TABLE aux.t1 DROP CHECK;
  SELECT sql FROM aux.sqlite_schema WHERE name='t1';
  SELECT a FROM aux.t1;
} {{CREATE TABLE t1(a CHECK(a>0), b)} 1}
do_execsql_test 8.1.2 { PRAGMA aux.integrity_check } {ok}

reset_db
do_execsql_test 8.2.0 {
  CREATE TEMP TABLE t1(a CHECK(a>0), b CHECK(b>0));
  ALTER TABLE t1 COLUMN b DROP CHECK;
  SELECT sql FROM temp.sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a CHECK(a>0), b)}}

reset_db
do_execsql_test 8.3.0 {
  CREATE TABLE t1(a, b, CHECK(a>0));
  BEGIN;
    ALTER TABLE t1 DROP CHECK;
  ROLLBACK;
  SELECT sql FROM sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a, b, CHECK(a>0))}}

#-------------------------------------------------------------------------
# 9.*: an invalid stored statement is refused, and left alone.
#
foreach {tn alter} {
  1 {ALTER TABLE t1 DROP CHECK}
  2 {ALTER TABLE t1 COLUMN a DROP CHECK}
} {
  reset_db
  do_execsql_test 9.$tn.0 {
    CREATE TABLE t1(a CHECK(a>0), b, CHECK(b>0));
    PRAGMA writable_schema = 1;
    UPDATE sqlite_schema SET sql = 'CREATE TABLE t1(a CHECK(a>0), b'
     WHERE name = 't1';
    PRAGMA writable_schema = 0;
  }
  do_catchsql_test 9.$tn.1 $alter {1 {database disk image is malformed}}
  do_execsql_test 9.$tn.2 {
    PRAGMA writable_schema = 1;
    SELECT sql FROM sqlite_schema WHERE type='table';
  } {{CREATE TABLE t1(a CHECK(a>0), b}}
}

finish_test
