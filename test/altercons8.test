#*************************************************************************
#
# Tests for
#
#   ALTER TABLE <table> DROP FOREIGN KEY(<cols>) REFERENCES <table>(<cols>)
#
# A FOREIGN KEY need not have a name, so it is dropped by what it says: the
# child columns, the parent table, and the parent columns.  The parent
# column list is optional, as it is in a CREATE TABLE, and a key written
# without one is matched only by a request without one.
#
# Nothing but the stored text changes.  Dropping a foreign key can only
# relax the table, so no row is examined and nothing is rebuilt; the
# parent's own key and any index behind it belong to the parent table.
#
# The clause is cut out at the extent the parser recorded during the
# reparse (PARSELOC_ForeignKey), so the column form and the table form are
# removed by the same code, and ON DELETE/ON UPDATE actions, a CONSTRAINT
# name and a DEFERRABLE clause all go with the key without being searched
# for.
#
# A key is paired with its text by walking Table.u.tab.pFKey and the
# recorded extents together: both are built by prepending, so they run in
# the same order.
#

set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix altercons8

# If SQLITE_OMIT_ALTERTABLE is defined, omit this file.
ifcapable !altertable {
  finish_test
  return
}
ifcapable !foreignkey {
  finish_test
  return
}

proc mkparent {} {
  execsql { CREATE TABLE p1(x PRIMARY KEY, y UNIQUE, z) }
}

#-------------------------------------------------------------------------
# 1.*: what is left in the stored statement.  Whatever the key carries -
# a name, referential actions, a DEFERRABLE clause - leaves with it.
#
foreach {tn shape before after} {
  1 {(a) REFERENCES p1(x)}
    { CREATE TABLE t1(a REFERENCES p1(x), b) }
    { CREATE TABLE t1(a, b) }

  2 {(a) REFERENCES p1(x)}
    { CREATE TABLE t1(a, b, FOREIGN KEY(a) REFERENCES p1(x)) }
    { CREATE TABLE t1(a, b) }

  3 {(a) REFERENCES p1(x)}
    { CREATE TABLE t1(a, b, CONSTRAINT k FOREIGN KEY(a) REFERENCES p1(x)) }
    { CREATE TABLE t1(a, b) }

  4 {(a) REFERENCES p1(x)}
    { CREATE TABLE t1(a CONSTRAINT k REFERENCES p1(x), b) }
    { CREATE TABLE t1(a, b) }

  5 {(a) REFERENCES p1}
    { CREATE TABLE t1(a REFERENCES p1, b) }
    { CREATE TABLE t1(a, b) }

  6 {(a) REFERENCES p1(x)}
    { CREATE TABLE t1(a REFERENCES p1(x) ON DELETE CASCADE, b) }
    { CREATE TABLE t1(a, b) }

  7 {(a) REFERENCES p1(x)}
    { CREATE TABLE t1(a REFERENCES p1(x) ON UPDATE SET NULL ON DELETE RESTRICT, b) }
    { CREATE TABLE t1(a, b) }

  8 {(a) REFERENCES p1(x)}
    { CREATE TABLE t1(a REFERENCES p1(x) DEFERRABLE INITIALLY DEFERRED, b) }
    { CREATE TABLE t1(a, b) }

  9 {(a) REFERENCES p1(x)}
    { CREATE TABLE t1(a REFERENCES p1(x) NOT DEFERRABLE, b) }
    { CREATE TABLE t1(a, b) }

  10 {(a) REFERENCES p1(x)}
     { CREATE TABLE t1(a, b, FOREIGN KEY(a) REFERENCES p1(x) ON UPDATE SET NULL DEFERRABLE INITIALLY DEFERRED) }
     { CREATE TABLE t1(a, b) }

  11 {(a,b) REFERENCES p1(x,y)}
     { CREATE TABLE t1(a, b, FOREIGN KEY(a,b) REFERENCES p1(x,y)) }
     { CREATE TABLE t1(a, b) }

  12 {(a) REFERENCES p1(x)}
     { CREATE TABLE t1(a, b, FOREIGN KEY(a) REFERENCES p1(x), CHECK(b>0)) }
     { CREATE TABLE t1(a, b, CHECK(b>0)) }

  13 {(a) REFERENCES p1(x)}
     { CREATE TABLE t1(a, b, CHECK(b>0), FOREIGN KEY(a) REFERENCES p1(x)) }
     { CREATE TABLE t1(a, b, CHECK(b>0)) }

  14 {(a) REFERENCES p1(x)}
     { CREATE TABLE t1(a INT NOT NULL REFERENCES p1(x) DEFAULT 5, b) }
     { CREATE TABLE t1(a INT NOT NULL DEFAULT 5, b) }

  15 {("my col") REFERENCES p1(x)}
     { CREATE TABLE t1("my col" REFERENCES p1(x), b) }
     { CREATE TABLE t1("my col", b) }

  16 {(a) REFERENCES p1(x)}
     { CREATE TABLE t1(a REFERENCES p1(x)) }
     { CREATE TABLE t1(a) }
} {
  reset_db
  mkparent
  do_execsql_test 1.$tn.1 $before
  do_execsql_test 1.$tn.2 "
    ALTER TABLE t1 DROP FOREIGN KEY $shape;
    SELECT sql FROM sqlite_schema WHERE name='t1';
  " [list [string trim $after]]
  do_execsql_test 1.$tn.3 { PRAGMA integrity_check } {ok}
}

#-------------------------------------------------------------------------
# 2.*: two keys saying the same thing both go; the ones saying something
# else stay, and stay attached to the right columns.
#
reset_db
mkparent
do_execsql_test 2.1.1 {
  CREATE TABLE t1(a REFERENCES p1(x), b, FOREIGN KEY(a) REFERENCES p1(x));
  ALTER TABLE t1 DROP FOREIGN KEY (a) REFERENCES p1(x);
  SELECT sql FROM sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a, b)}}

reset_db
mkparent
do_execsql_test 2.2.1 {
  CREATE TABLE t1(a REFERENCES p1(x), b REFERENCES p1(y), c REFERENCES p1(x));
  ALTER TABLE t1 DROP FOREIGN KEY (b) REFERENCES p1(y);
  SELECT sql FROM sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a REFERENCES p1(x), b, c REFERENCES p1(x))}}

# The survivors are still enforced, and still on their own columns.
#
do_execsql_test 2.2.2 { PRAGMA foreign_keys = ON }
do_catchsql_test 2.2.3 {
  INSERT INTO t1 VALUES('nope', NULL, NULL);
} {1 {FOREIGN KEY constraint failed}}
do_execsql_test 2.2.4 {
  INSERT INTO t1 VALUES(NULL, 'anything', NULL);
  SELECT count(*) FROM t1;
} {1}

#-------------------------------------------------------------------------
# 3.*: a key is matched by what it says and nothing else.
#
foreach {tn body shape} {
  1 {a REFERENCES p1(x), b}                  {(a) REFERENCES p1(y)}
  2 {a REFERENCES p1(x), b}                  {(b) REFERENCES p1(x)}
  3 {a REFERENCES p1(x), b}                  {(a) REFERENCES nosuch(x)}
  4 {a REFERENCES p1, b}                     {(a) REFERENCES p1(x)}
  5 {a REFERENCES p1(x), b}                  {(a) REFERENCES p1}
  6 {a, b, FOREIGN KEY(a,b) REFERENCES p1(x,y)} {(b,a) REFERENCES p1(y,x)}
  7 {a, b, FOREIGN KEY(a,b) REFERENCES p1(x,y)} {(a) REFERENCES p1(x)}
  8 {a, b}                                   {(a) REFERENCES p1(x)}
} {
  reset_db
  mkparent
  execsql "CREATE TABLE t1($body)"
  set before [execsql {SELECT sql FROM sqlite_schema WHERE name='t1'}]
  do_catchsql_test 3.$tn.1 "
    ALTER TABLE t1 DROP FOREIGN KEY $shape;
  " {1 {table "t1" has no such FOREIGN KEY}}
  do_execsql_test 3.$tn.2 {
    SELECT sql FROM sqlite_schema WHERE name='t1';
  } $before
}

# Case-insensitive on both the table and the column names.
#
reset_db
mkparent
do_execsql_test 3.9 {
  CREATE TABLE t1(a REFERENCES p1(x), b);
  ALTER TABLE t1 DROP FOREIGN KEY (A) REFERENCES P1(X);
  SELECT sql FROM sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a, b)}}

#-------------------------------------------------------------------------
# 4.*: the rows are not touched, and what the key used to reject is now
# accepted.
#
reset_db
mkparent
do_execsql_test 4.1 {
  PRAGMA foreign_keys = ON;
  INSERT INTO p1 VALUES('k', 'j', 1);
  CREATE TABLE t1(a REFERENCES p1(x), b);
  INSERT INTO t1 VALUES('k', 1);
}
do_catchsql_test 4.2 {
  INSERT INTO t1 VALUES('nope', 2);
} {1 {FOREIGN KEY constraint failed}}
do_execsql_test 4.3 {
  ALTER TABLE t1 DROP FOREIGN KEY (a) REFERENCES p1(x);
  INSERT INTO t1 VALUES('nope', 2);
  SELECT a, b FROM t1 ORDER BY b;
} {k 1 nope 2}
do_execsql_test 4.4 { PRAGMA integrity_check } {ok}

# The parent table is untouched, index and all.
#
do_execsql_test 4.5 {
  SELECT sql FROM sqlite_schema WHERE name='p1';
  SELECT count(*) FROM p1;
} {{CREATE TABLE p1(x PRIMARY KEY, y UNIQUE, z)} 1}

#-------------------------------------------------------------------------
# 5.*: refusals.  Nothing is changed by one.
#
reset_db
mkparent
do_catchsql_test 5.1 {
  CREATE VIEW v1 AS SELECT 1 AS x;
  ALTER TABLE v1 DROP FOREIGN KEY (x) REFERENCES p1(x);
} {1 {cannot edit constraints of view "v1"}}

do_catchsql_test 5.2 {
  ALTER TABLE nosuchtable DROP FOREIGN KEY (a) REFERENCES p1(x);
} {1 {no such table: nosuchtable}}

do_catchsql_test 5.3 {
  ALTER TABLE sqlite_schema DROP FOREIGN KEY (a) REFERENCES p1(x);
} {1 {table sqlite_master may not be altered}}

# Dropping the same key twice: the second time there is none.
#
reset_db
mkparent
do_execsql_test 5.4.1 {
  CREATE TABLE t1(a REFERENCES p1(x), b);
  ALTER TABLE t1 DROP FOREIGN KEY (a) REFERENCES p1(x);
}
do_catchsql_test 5.4.2 {
  ALTER TABLE t1 DROP FOREIGN KEY (a) REFERENCES p1(x);
} {1 {table "t1" has no such FOREIGN KEY}}

#-------------------------------------------------------------------------
# 6.*: the other schemas.
#
reset_db
forcedelete test.db2
do_execsql_test 6.1.0 {
  ATTACH 'test.db2' AS aux;
  CREATE TABLE aux.p1(x PRIMARY KEY);
  CREATE TABLE aux.t1(a REFERENCES p1(x), b);
  INSERT INTO aux.t1 VALUES(NULL, 1);
}
do_execsql_test 6.1.1 {
  ALTER TABLE aux.t1 DROP FOREIGN KEY (a) REFERENCES p1(x);
  SELECT sql FROM aux.sqlite_schema WHERE name='t1';
  SELECT b FROM aux.t1;
} {{CREATE TABLE t1(a, b)} 1}
do_execsql_test 6.1.2 { PRAGMA aux.integrity_check } {ok}

reset_db
do_execsql_test 6.2.0 {
  CREATE TEMP TABLE p1(x PRIMARY KEY);
  CREATE TEMP TABLE t1(a REFERENCES p1(x), b);
  ALTER TABLE t1 DROP FOREIGN KEY (a) REFERENCES p1(x);
  SELECT sql FROM temp.sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a, b)}}

#-------------------------------------------------------------------------
# 7.*: ROLLBACK takes the whole edit with it.
#
reset_db
mkparent
do_execsql_test 7.1 {
  CREATE TABLE t1(a REFERENCES p1(x), b);
  BEGIN;
    ALTER TABLE t1 DROP FOREIGN KEY (a) REFERENCES p1(x);
  ROLLBACK;
  SELECT sql FROM sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a REFERENCES p1(x), b)}}

#-------------------------------------------------------------------------
# 8.*: a DEFERRABLE clause written on a column that has no REFERENCES of
# its own belongs to an earlier key.  It sits nowhere near that key's
# recorded extent, so the extent is left as it was and the clause is not
# dragged out with the key.
#
reset_db
mkparent
do_execsql_test 8.1 {
  CREATE TABLE t1(a REFERENCES p1(x), b DEFERRABLE INITIALLY DEFERRED);
  ALTER TABLE t1 DROP FOREIGN KEY (a) REFERENCES p1(x);
  SELECT sql FROM sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a, b DEFERRABLE INITIALLY DEFERRED)}}
do_execsql_test 8.2 { PRAGMA integrity_check } {ok}

#-------------------------------------------------------------------------
# 9.*: an invalid stored statement is refused, and left alone.
#
reset_db
mkparent
do_execsql_test 9.1.0 {
  CREATE TABLE t1(a REFERENCES p1(x), b);
  PRAGMA writable_schema = 1;
  UPDATE sqlite_schema SET sql = 'CREATE TABLE t1(a REFERENCES p1(x), b'
   WHERE name = 't1';
  PRAGMA writable_schema = 0;
}
do_catchsql_test 9.1.1 {
  ALTER TABLE t1 DROP FOREIGN KEY (a) REFERENCES p1(x);
} {1 {malformed database schema (t1) - incomplete input}}
do_execsql_test 9.1.2 {
  PRAGMA writable_schema = 1;
  SELECT sql FROM sqlite_schema WHERE name='t1';
} {{CREATE TABLE t1(a REFERENCES p1(x), b}}

finish_test
